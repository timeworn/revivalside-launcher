{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "revivalside-launcher",
  "version": "0.1.0",
  "identifier": "com.timeworn.revivalside-launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "revivalside-launcher",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMTQ2RDc0QjgzMjUyN0QKUldSOVVqSzRkRzBVRTlCeFRaZmdtemVneU43bkE1QnZXcGpYNVc2Zks0Uk5EMmxBOFB3ejZVeU8K",
      "endpoints": [
        "https://github.com/timeworn/revivalside-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}